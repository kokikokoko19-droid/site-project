# 値はコミットしない。実際の値は .env に置く。
FANZA_API_ID=
FANZA_AFFILIATE_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
DB_PATH=
EXPORT_DIR=
PUBLIC_GA4_ID=
# X 自動投稿（src/x/cli.ts）。SITE_URL は --with-url のときだけ必要（末尾のスラッシュなし）。X_DAILY_MAX は1日の投稿上限（空なら 5）。
SITE_URL=
X_DAILY_MAX=3
# 配信（scripts/deploy.sh。GitHub Actions では secrets に同名で登録。docs/07_運用手順.md の 5 章）。DEPLOY_PORT の既定は 22。
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=
DEPLOY_PATH=
DEPLOY_KEY_FILE=
DEPLOY_KEEP=
DEPLOY_CHECK_URL=
