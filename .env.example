# 値はコミットしない。実際の値は .env に置く。
FANZA_API_ID=
FANZA_AFFILIATE_ID=
# API の offset の上限。空なら 5000（2026年12月ごろの公式変更に合わせた既定値）。旧仕様に戻すときだけ 50000。
FANZA_MAX_OFFSET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
DB_PATH=
EXPORT_DIR=
PUBLIC_GA4_ID=
# X 自動投稿（src/x/cli.ts）。SITE_URL は --with-url のときだけ必要（末尾のスラッシュなし）。X_DAILY_MAX は1日の投稿上限（空なら 5）。
SITE_URL=
X_DAILY_MAX=3
# 配信（scripts/deploy.sh。GitHub Actions では secrets に同名で登録。docs/07_運用手順.md の 5 章）。DEPLOY_PORT の既定は 22。
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=
DEPLOY_PATH=
DEPLOY_KEY_FILE=
DEPLOY_KEEP=
DEPLOY_CHECK_URL=
# アフィリエイトリンクの切替。off（既定）は「FANZAで見る」を公式の商品ページ（IDなし）へ、on はアフィリエイトURLへ。承認後に on にする（docs/07 の 8 章）。
AFFILIATE_LINKS=off
# 追加申請の承認後に発行されるサイト用アフィリエイトID（例: 末尾 -003）。設定すると API 由来URLのIDを差し替える。空なら差し替えない。
FANZA_SITE_AFFILIATE_ID=

# 仮公開（公開前の国内確認）のあいだ全ページを noindex にする。本公開のときは空にする（docs/11 段階1・3）
PUBLIC_NOINDEX=
