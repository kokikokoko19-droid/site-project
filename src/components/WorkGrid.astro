---
// 作品カードの格子。作品の配列を受け取り、WorkCard の表示形に直して .grid に並べる。
// 文言は自動文（データ駆動テンプレ）だけで、公式の紹介文やレビュー本文は使わない。
import type { CatalogWork } from '../lib/catalog.ts';
import { cardText } from '../lib/autotext.ts';
import WorkCard from './WorkCard.astro';

interface Props {
  works: CatalogWork[];
  /** 作品が0件のときに出す文言 */
  empty?: string;
}

const { works, empty = '該当する作品がありません。' } = Astro.props;

// データ層の Work から、カードに必要な項目だけを取り出す（対応表は WorkCard.astro の冒頭を参照）
const cards = works.map((w) => ({
  work: {
    id: w.contentId,
    title: w.title,
    imageSmall: w.imageSmall,
    actresses: w.actresses.map((a) => a.name),
    maker: w.makers[0]?.name ?? null,
    cardText: cardText(w),
    labels: w.derivedLabels,
  },
  href: `/v/${w.contentId}/`,
}));
---

{
  cards.length > 0 ? (
    <div class="grid">
      {cards.map((c) => (
        <WorkCard work={c.work} href={c.href} />
      ))}
    </div>
  ) : (
    <div class="empty">
      <p>{empty}</p>
    </div>
  )
}

<style is:global>
  /* .chip は button 向けの指定（高さ・余白・文字の位置）なので、a 要素のリンクとして使うときの表示をここで補う。
     チップをリンクにするページ（トップ・軸ページ・ランキング）はどれも WorkGrid を使うので、ここに置く。
     本来は common.css に移すのが望ましい。 */
  a.chip {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding-block: 4px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  a.chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  /* 名前のあとに添える件数 */
  a.chip .n {
    margin-left: 6px;
    color: var(--fg2);
  }
</style>
