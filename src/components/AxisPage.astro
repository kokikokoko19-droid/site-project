---
// 軸ページ（出演者・シリーズ・メーカー・ジャンル）共通の本体。
// works は配信開始日の降順で渡される前提（catalog の索引がその順）。PER_PAGE 件ずつページ送りにする
// （1ページ目は /{kind}/{id}/、2ページ目以降は /{kind}/{id}/page/{n}/。各ページの canonical は自分自身。第三者レビュー C-12）。
// 作品が3本未満のシリーズ・メーカーは noindex（sitemap からも外す。astro.config.mjs。第三者レビュー C-3）。
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import WorkGrid from './WorkGrid.astro';
import { loadCatalog } from '../lib/catalog.ts';
import type { CatalogWork } from '../lib/catalog.ts';
import { fmtDate } from '../lib/format.ts';
import { AXIS_PER_PAGE } from '../lib/card.ts';

type Kind = 'actress' | 'series' | 'maker' | 'genre';

interface Props {
  kind: Kind;
  id: string;
  name: string;
  works: CatalogWork[];
  /** 何ページ目か（1から）。既定 1 */
  page?: number;
}

const { kind, id, name, works, page = 1 } = Astro.props;
const catalog = loadCatalog();

const PER_PAGE = AXIS_PER_PAGE; // 1ページに並べる作品数（ページ送りの単位。lib/card.ts）
const MAX_RELATED = 8; // 関連する軸の各グループの上限

// 軸ごとの表示名と、探索ページのクエリのキー（値は名前）。ページのパスは kind と同じ（/actress/ など）
const LABEL: Record<Kind, string> = { actress: '出演者', series: 'シリーズ', maker: 'メーカー', genre: 'ジャンル' };
const QUERY: Record<Kind, string> = { actress: 'act', series: 'ser', maker: 'mak', genre: 'g' };
const PICK: Record<Kind, (w: CatalogWork) => { id: string; name: string }[]> = {
  actress: (w) => w.actresses,
  series: (w) => w.series,
  maker: (w) => w.makers,
  genre: (w) => w.genres,
};

type Item = { id: string; name: string; count: number };
type Group = { title: string; kind: Kind; items: Item[] };

/** list の作品に付いた kind の参照を、作品数の多い順に上位 n 件返す（exclude の id は除く）。同数は先に現れた順（新しい作品側） */
function top(list: CatalogWork[], target: Kind, n: number, exclude?: string): Item[] {
  const counts = new Map<string, number>();
  for (const w of list) {
    const seen = new Set<string>();
    for (const r of PICK[target](w)) {
      if (!r.id || r.id === exclude || seen.has(r.id)) continue;
      seen.add(r.id);
      counts.set(r.id, (counts.get(r.id) ?? 0) + 1);
    }
  }
  return [...counts]
    .sort((a, b) => b[1] - a[1])
    .slice(0, n)
    .map(([rid, count]) => ({ id: rid, name: catalog.refNames[target].get(rid) ?? rid, count }));
}

/** 関連する軸。軸ごとに何を並べるかはここで決める */
function relatedGroups(): Group[] {
  const groups: Group[] = [];
  if (kind === 'actress') {
    groups.push({ title: '共演の多い出演者', kind: 'actress', items: top(works, 'actress', MAX_RELATED, id) });
  } else if (kind === 'series') {
    const makers = top(works, 'maker', MAX_RELATED);
    // 同じメーカーの作品を集めて、他のシリーズを数える（複数のメーカーに渡るときは和集合）
    const seen = new Set<string>();
    const sameMaker: CatalogWork[] = [];
    for (const m of makers) {
      for (const w of catalog.byMaker.get(m.id) ?? []) {
        if (!seen.has(w.contentId)) { seen.add(w.contentId); sameMaker.push(w); }
      }
    }
    groups.push({ title: 'メーカー', kind: 'maker', items: makers });
    groups.push({ title: '同じメーカーの他のシリーズ', kind: 'series', items: top(sameMaker, 'series', MAX_RELATED, id) });
  } else if (kind === 'maker') {
    groups.push({ title: '所属シリーズ', kind: 'series', items: top(works, 'series', MAX_RELATED) });
    groups.push({ title: 'ジャンルの分布', kind: 'genre', items: top(works, 'genre', MAX_RELATED) });
  } else {
    groups.push({ title: '同時に付くことが多いジャンル', kind: 'genre', items: top(works, 'genre', MAX_RELATED, id) });
  }
  return groups.filter((g) => g.items.length > 0);
}

const label = LABEL[kind];
const total = works.length;
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const shown = works.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const exploreHref = `/explore/?${QUERY[kind]}=${encodeURIComponent(name)}`;
const groups = relatedGroups();
const baseHref = `/${kind}/${encodeURIComponent(id)}/`;
const pageHref = (n: number) => (n <= 1 ? baseHref : `${baseHref}page/${n}/`);
const noindex = (kind === 'series' || kind === 'maker' || kind === 'actress') && total < 3;

// title と description にページごとに変わる数値（作品数・平均評価・最新の配信日）を入れる（第三者レビュー C-13）
let sum = 0, reviews = 0;
for (const w of works) if (w.reviewAvg !== null && w.reviewCount > 0) { sum += w.reviewAvg * w.reviewCount; reviews += w.reviewCount; }
const latest = fmtDate(works[0]?.releasedAt ?? null);
const pageNote = page > 1 ? `（${page}ページ目）` : '';
const title = `${name}のおすすめ作品・新作一覧（${total}本）${pageNote}`;
const description = [
  `${label}「${name}」の作品${total}本を、配信開始日の新しい順に並べています${pageNote}。`,
  reviews > 0 ? `平均評価は${(sum / reviews).toFixed(2)}（レビュー${reviews}件）。` : '',
  latest ? `最新の配信日は${latest}です。` : '',
].join('');
const crumbs = [
  { href: '/', label: 'トップ' },
  { href: `/${kind}/`, label: `${label}一覧` },
  ...(page > 1 ? [{ href: baseHref, label: name }, { label: `${page}ページ目` }] : [{ label: name }]),
];
---

<Base title={title} description={description} noindex={noindex} dataUpdatedAt={catalog.meta.lastIngestAt ?? undefined}>
  <Breadcrumb items={crumbs} />

  <section class="section axis-page" style="margin-top: 8px">
    <div class="muted">{label}</div>
    <h1>{name}</h1>
    <p class="muted">作品 <span class="nowrap">{total}本</span>（配信開始日の新しい順{pages > 1 ? `、${page} / ${pages}ページ` : ''}）{latest && <>。最新の配信日 <span class="nowrap">{latest}</span></>}</p>
  </section>

  <section class="section">
    <WorkGrid works={shown} empty="この軸に該当する作品はまだありません。" eager={page === 1 ? 4 : 2} />
    {
      pages > 1 && (
        <nav class="pager" aria-label="ページ送り">
          {page > 1 && <a class="btn" href={pageHref(page - 1)} rel="prev">‹ 前へ</a>}
          {Array.from({ length: pages }, (_, k) => k + 1).map((n) =>
            n === page ? <span class="btn on" aria-current="page">{n}</span> : <a class="btn" href={pageHref(n)}>{n}</a>,
          )}
          {page < pages && <a class="btn" href={pageHref(page + 1)} rel="next">次へ ›</a>}
        </nav>
      )
    }
    <p style="margin-top: 16px"><a class="more-link" href={exploreHref}>探索ページで条件を足して絞り込む</a></p>
  </section>

  {
    groups.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>関連する軸</h2></div>
        <div style="display: grid; gap: 24px">
          {groups.map((g) => (
            <div style="display: grid; gap: 8px">
              <h3>{g.title}</h3>
              <div class="chips">
                {g.items.map((it) => (
                  <a class="chip" href={`/${g.kind}/${it.id}/`}>{it.name}<span class="n">{it.count}</span></a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <AdSlot name="axis-bottom" />
</Base>
