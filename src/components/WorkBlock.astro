---
// 作品のブロック（「○○のおすすめ作品 10 選」型の記事の 1 作品分）。出演者ページの「おすすめ作品 N 選」と特集ページで使う。
// 上から: 順位と題名 → 表紙 → データの 1 行 → 公式サンプル画像（先頭 5 枚。運営者指示 2026-11-28「写真を大きく、多く」で 3 枚から増やした）→ 一言 → 「FANZAで見る」。
// ボタンに「PR」の小文字は付けない（運営者決定 2026-11-28）。広告表記は全ページ上部の帯（layouts/Base.astro の .pr-band）で担保する。
// 画像は公式配信の直リンクをそのまま出す。規約により加工は拡大縮小のみ（切り取らず object-fit: contain で枠に収める）。
// 一言は運営者の note（特集の frontmatter、または data/copy.json の作品の文）があればそれ、無ければデータから機械的に作る自動文（summaryText。非露骨）。公式の紹介文・レビュー本文は使わない。
// 出演者ページは数千ページ生成されるので、属性は必要なものだけにする（1 ページ 10 ブロックで HTML 30KB 以内）。
import type { CatalogWork } from '../lib/catalog.ts';
import { toCard } from '../lib/card.ts';
import { fmtDate, minutes, sampleSmallUrl } from '../lib/format.ts';
import { summaryText } from '../lib/autotext.ts';

interface Props {
  work: CatalogWork;
  /** 順位。指定すると題名の左に明朝の数字を出す */
  rank?: number;
  /** 運営者の一言。あれば自動文の代わりに出す */
  note?: string;
  /** サンプル画像の枚数（先頭から。既定 5） */
  samples?: number;
  /** 計測用の位置（data-cta-pos）。出演者ページは actress-top、特集は feature */
  ctaPos: string;
  /** 最初のブロックだけ true にして、表紙の遅延読み込みをやめる */
  eager?: boolean;
  /** 出演者名を出さない（出演者ページで、その出演者の作品を並べるとき） */
  hideActress?: boolean;
}

const { work, rank, note, samples = 5, ctaPos, eager = false, hideActress = false } = Astro.props;
const card = toCard(work);
const href = `/v/${work.contentId}/`;
// レビューがこの件数以上のときだけ評価を出す（WorkCard の「参考」扱いの境目と同じ）
const RELIABLE_REVIEWS = 5;

// 横長ジャケット（800×538 級）を優先。無ければ縦長の小さい画像（147×200）を原寸以下で枠に収める（WorkCard と同じ）
const img = card.imageLarge
  ? { src: card.imageLarge, w: 800, h: 538, small: false }
  : card.imageSmall
    ? { src: card.imageSmall, w: 147, h: 200, small: true }
    : null;

const facts = [
  !hideActress && card.actresses.length > 0 ? card.actresses.join('、') : '',
  card.maker ?? '',
  fmtDate(work.releasedAt) && `${fmtDate(work.releasedAt)} 配信`,
  minutes(work.volumeMin),
].filter((s) => s !== '');
const rated = card.reviewAvg !== null && card.reviewCount >= RELIABLE_REVIEWS;

const shots = (work.sampleImages ?? [])
  .filter((u) => typeof u === 'string' && u.trim() !== '')
  .slice(0, samples)
  .map((u) => ({ src: u.trim(), small: sampleSmallUrl(u.trim()) }));
// 大きい版が読めないときは小さい版へ（1 回だけ）
const FALLBACK = 'this.onerror=null;this.src=this.dataset.s';

const text = note?.trim() || '';
// 価格は書かない（変わる数字は値札とカードに任せる。特集・記事の方針 docs/15）
const auto = text === '' ? summaryText(work, { price: false }) : '';
---

<article class="work-block">
  <h3 class="wb-head">
    {rank !== undefined && <span class="rank-no" role="img" aria-label={`${rank}位`}>{rank}</span>}
    <a class="wb-title" href={href}>{work.title}</a>
  </h3>
  <a class="wb-cover thumb jk" href={href} tabindex="-1" aria-hidden="true">
    {img && <img class:list={{ small: img.small }} src={img.src} alt="" width={img.w} height={img.h} loading={eager ? undefined : 'lazy'} decoding="async" />}
  </a>
  {(facts.length > 0 || rated) && (
    <p class="wb-facts">
      {facts.map((f) => <span>{f}</span>)}
      {rated && <span>★ {card.reviewAvg!.toFixed(1)}（{card.reviewCount}件）</span>}
    </p>
  )}
  {shots.length > 0 && (
    <div class="wb-samples" role="group" aria-label="サンプル画像">
      {shots.map((s) => (
        <span><img src={s.src} alt="" loading="lazy" decoding="async" data-s={s.small ?? undefined} onerror={s.small ? FALLBACK : undefined} /></span>
      ))}
    </div>
  )}
  {text !== '' ? <p class="wb-note">{text}</p> : auto !== '' && <p class="wb-note auto">{auto}</p>}
  {work.outboundUrl && (
    <p class="wb-cta"><a class="btn btn-cta" href={`/go/${work.contentId}/`} rel="sponsored nofollow" data-cta="block" data-cta-pos={ctaPos}>FANZAで見る</a></p>
  )}
</article>

<style is:global>
  /* is:global にする理由: scoped だと全要素に属性が付き、数千ページ分の HTML が膨らむ。.work-block の配下だけに効かせる */
  .work-block { display: grid; gap: 12px; max-width: 760px; min-width: 0; margin-top: calc(var(--sp) * 2); }
  .work-block + .work-block { margin-top: calc(var(--sp) * 6); padding-top: calc(var(--sp) * 3); border-top: 1px solid rgba(255,255,255,.08); }
  .work-block .wb-head { display: flex; align-items: flex-start; gap: 12px; margin: 0; font-size: 18px; line-height: 1.45; }
  .work-block .wb-head .rank-no { font-size: 30px; line-height: 1; min-width: 0; }
  .work-block .wb-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; overflow-wrap: anywhere; color: inherit; padding: 5px 0; /* 押せる範囲を 32px 以上に（C-18）。display は省略表示のため -webkit-box のまま */ }
  .work-block .wb-cover { display: block; }
  .work-block .wb-facts { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0; font-size: 13px; color: var(--fg2); }
  /* サンプル画像はブロックの幅いっぱいに縦に積む（参考サイトと同じ見せ方。運営者指示 2026-11-28「写真を大きく」）。枠は 4:3 で contain、切り取りはしない */
  .work-block .wb-samples { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .work-block .wb-samples > span { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 2px; background: var(--bg2); }
  .work-block .wb-samples img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  /* 運営者の文（docs/07 の 11 章）の改行をそのまま見せる */
  .work-block .wb-note { margin: 0; line-height: 1.8; white-space: pre-line; overflow-wrap: anywhere; }
  .work-block .wb-note.auto { color: var(--fg2); font-size: 14px; }
  .work-block .wb-cta { margin: 0; }
  .work-block .wb-cta .btn { min-width: 200px; }
  @media (max-width: 639px) {
    .work-block .wb-head { font-size: 16px; }
    .work-block .wb-cta .btn { display: flex; width: 100%; }
  }
</style>
