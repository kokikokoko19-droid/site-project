---
// サンプル動画（公式の埋め込みプレーヤー）。docs/05_技術調査_動画埋め込み.md の結論に従い、
// API の sampleMovieURL（sizes）をそのまま iframe で使う。手組みのURLは使わない。
// 初期HTMLには iframe を出さない。最初は枠とボタンだけを出し、押されたときに iframe を差し込む
// （公式プレーヤーの読み込みを再生時まで遅らせ、初期表示を軽く保つため）。
// 動画が無い作品（sampleMovie が null）では何も出さない。
// 見た目: 枠の中に作品の主画像（poster。切り取らず contain で表示）、その下に幅いっぱいの「▶ サンプル動画を再生」ボタン。
// 画像の上にボタンや文字は重ねない。自動再生はしない（公式プレーヤーが iframe での自動再生を許さず、通信量も大きいため）。
import type { SampleMovie } from '../data/types.ts';

interface Props {
  movie?: SampleMovie | null;
  /** iframe の title（読み上げ用）に使う作品名 */
  title?: string;
  /** 動画があるときだけ、枠の上に出す見出し（作品ページ用）。省略すると出さない */
  heading?: string;
  /** 枠に表示する作品の主画像の URL（公式配信の直リンク。imageLarge、無ければ imageSmall）。省略するとボタンだけを出す */
  poster?: string | null;
  /** poster の代替テキスト */
  posterAlt?: string;
}

const { movie = null, title = '', heading = '', poster = null, posterAlt = '' } = Astro.props;

/** 使うサイズの優先順。大きいものから（先に見つかったものを採る） */
const SIZE_KEYS = ['size_720_480', 'size_644_414', 'size_560_360', 'size_476_306'] as const;
// https 以外（http や javascript: など）は埋め込まない。ページが https なので http は混在コンテンツになる
const key = SIZE_KEYS.find((k) => /^https:\/\//.test(movie?.sizes?.[k] ?? ''));
const src = key ? movie!.sizes[key] : null;
const frameTitle = title ? `${title}のサンプル動画` : 'サンプル動画';

// 再生ボタンのクリックで iframe を差し込む小さなスクリプト（HTML にそのまま埋め込む）。
// ページに複数あっても登録は1回だけで、クリックはイベント委任で拾う。差し込み済みなら何もしない。
const PLAYER_SCRIPT = `(function () {
  if (window.__sampleMovieBound) return;
  window.__sampleMovieBound = true;
  document.addEventListener('click', function (e) {
    var el = e.target;
    var btn = el && el.closest && el.closest('[data-sample-play]');
    if (!btn) return;
    var box = btn.closest('[data-sample-movie]');
    if (!box || box.querySelector('iframe')) return;
    var src = box.getAttribute('data-src') || '';
    if (src.indexOf('https://') !== 0) return;
    var frame = document.createElement('iframe');
    frame.src = src;
    frame.title = box.getAttribute('data-title') || 'サンプル動画';
    frame.setAttribute('allowfullscreen', '');
    frame.setAttribute('loading', 'lazy');
    frame.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
    var area = box.querySelector('.sm-frame');
    if (!area) { area = document.createElement('div'); area.className = 'sm-frame'; box.insertBefore(area, box.firstChild); }
    area.textContent = '';
    area.classList.add('is-playing');
    area.appendChild(frame);
    box.classList.add('is-playing');
    frame.focus();
  });
})();`;
---

{
  src && (
    <div>
      {heading && <div class="section-head"><h2>{heading}</h2></div>}
      <div class="sm" data-sample-movie data-src={src} data-title={frameTitle}>
        {/* 枠全体のクリックでも再生する（キーボードや読み上げは下のボタンを使うので、枠は操作対象にしない） */}
        {poster && (
          <div class="sm-frame" data-sample-play>
            <img src={poster} alt={posterAlt} loading="lazy" decoding="async" />
          </div>
        )}
        <button class="btn btn-cta btn-block sm-btn" type="button" data-sample-play><span aria-hidden="true">▶</span> サンプル動画を再生</button>
        <p class="sm-note">公式プレーヤーを読み込みます（音が出ることがあります）</p>
      </div>
    </div>
  )
}
{src && <script is:inline set:html={PLAYER_SCRIPT} />}

<style is:global>
  /* is:global にする理由: 全要素に属性が付くのを避ける。クラス名は .sm で始め、data-sample-movie はこの部品でしか使わない。
     公式プレーヤーの主なサイズ（720x480 など）は 3:2 に近いので、差し込みの前後で高さが変わらないよう枠も 3:2 にする。
     幅の上限は最大サイズの 720px（それ以上に広げるとぼやける）。主画像は切り取らず contain で収める */
  .sm { display: grid; gap: calc(var(--sp) * 1.5); width: 100%; max-width: 720px; }
  .sm-frame { position: relative; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 3px; background: var(--bg2); box-shadow: inset 0 0 0 1px rgba(255,255,255,.07); cursor: pointer; }
  .sm-frame img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .sm-frame.is-playing { cursor: auto; background: #000; }
  .sm-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .sm .sm-btn { min-height: 48px; font-size: 15px; }
  .sm-note { margin: 0; color: var(--fg2); font-size: 11.5px; line-height: 1.5; text-align: center; }
  /* 再生が始まったらボタンと注記は畳む（枠が iframe になる） */
  .sm.is-playing .sm-btn, .sm.is-playing .sm-note { display: none; }
</style>
