---
// 出演者ページ本体（検索の入口）。プロフィール表、おすすめ10選（ベイズ平均）、新着、セール中、シリーズ別、共演、全作品、まとめ。
// 文言は自動文だけ。公式の紹介文・レビュー本文・顔写真は使わない。
import '../styles/actress.css';
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import WorkGrid from './WorkGrid.astro';
import WorkCard from './WorkCard.astro';
import SampleMovie from './SampleMovie.astro';
import ProfileTable from './ProfileTable.astro';
import Toc from './Toc.astro';
import { loadCatalog } from '../lib/catalog.ts';
import type { CatalogWork } from '../lib/catalog.ts';
import { actressStats, globalMeanAvg, workBayes } from '../lib/actress-stats.ts';
import { actressIntro, actressSummary } from '../lib/autotext-actress.ts';
import { cardText } from '../lib/autotext.ts';

interface Props {
  id: string;
  name: string;
  works: CatalogWork[];
}

const { id, name, works } = Astro.props;
const catalog = loadCatalog();
const profile = catalog.actressProfiles.get(id) ?? null;
const stats = actressStats(catalog).get(id)!;

const MAX_ALL = 60;
const year = new Date().getFullYear();
const intro = actressIntro(profile, stats);
const summary = actressSummary(profile, stats);

const meanAvg = globalMeanAvg(catalog);
// おすすめ10選: ベイズ平均の降順。同点は新しい順（works は配信開始日の降順なので安定ソートで保たれる）
const top = works
  .map((w) => ({ w, score: workBayes(w, meanAvg) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 10);
const movieIds = new Set(top.filter((t) => t.w.sampleMovie).slice(0, 3).map((t) => t.w.contentId));
const latest = works.slice(0, 5);
const sale = works.filter((w) => w.derivedLabels.includes('セール中')).slice(0, 8);
const seriesTop = stats.series.slice(0, 5);
const coStars = stats.coStars.slice(0, 8);
const shown = works.slice(0, MAX_ALL);

// WorkGrid と同じ対応で、カードの表示形にする
const card = (w: CatalogWork) => ({
  id: w.contentId,
  title: w.title,
  imageSmall: w.imageSmall,
  actresses: w.actresses.map((a) => a.name),
  maker: w.makers[0]?.name ?? null,
  cardText: cardText(w),
  labels: w.derivedLabels,
});

const toc = [
  { id: 'profile', label: 'プロフィール' },
  { id: 'top10', label: 'おすすめ作品10選' },
  { id: 'new', label: '新着' },
  ...(sale.length > 0 ? [{ id: 'sale', label: 'セール中' }] : []),
  ...(seriesTop.length > 0 ? [{ id: 'series', label: 'シリーズ別' }] : []),
  ...(coStars.length > 0 ? [{ id: 'costars', label: '共演の多い出演者' }] : []),
  { id: 'all', label: '全作品' },
  { id: 'summary', label: 'まとめ' },
];

const pageTitle = `${name}のおすすめ作品ランキング${year}`;
const base = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, base).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', name, url: abs(`/actress/${id}/`) },
    {
      '@type': 'ItemList',
      name: `${name}のおすすめ作品10選`,
      itemListElement: top.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/v/${t.w.contentId}/`) })),
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const exploreHref = `/explore/?act=${encodeURIComponent(name)}`;
const score = (n: number) => n.toFixed(2);
---

<Base title={pageTitle} description={intro.slice(0, 120)} ogType="article" dataUpdatedAt={catalog.meta.lastIngestAt ?? undefined}>
  <script slot="head" type="application/ld+json" set:html={jsonLdText} />

  <nav class="crumb" aria-label="パンくず">
    <a href="/">トップ</a><span aria-hidden="true"> / </span><a href="/explore/">探索</a><span aria-hidden="true"> / </span><span aria-current="page">出演者: {name}</span>
  </nav>

  <article class="actress-page">
    <header class="section" style="margin-top: 16px">
      <h1>{name}のおすすめ作品ランキング</h1>
      <p class="lead">{intro}</p>
    </header>

    <Toc items={toc} />

    <section class="section" id="profile">
      <div class="section-head"><h2>プロフィール</h2></div>
      <ProfileTable profile={profile} />
    </section>

    <section class="section" id="top10">
      <div class="section-head"><h2>おすすめ作品10選</h2></div>
      <p class="muted">レビューの平均を、件数の少なさを補正して並べています（ベイズ平均）。</p>
      <ol class="rank-list">
        {top.map((t, i) => (
          <li class="rank-item">
            <div class="rank-head">
              <span class="rank-no" aria-label={`${i + 1}位`}>{i + 1}</span>
              <p class="rank-stat">
                {t.w.reviewAvg !== null && t.w.reviewCount > 0
                  ? `評価 ${score(t.w.reviewAvg)}（レビュー${t.w.reviewCount}件）`
                  : 'レビューはまだありません'}
              </p>
            </div>
            <WorkCard work={card(t.w)} />
            {t.w.derivedLabels.length > 0 && (
              <p class="rank-labels muted">ラベル: {t.w.derivedLabels.join('、')}</p>
            )}
            <div class="rank-actions">
              <a class="btn" href={`/v/${t.w.contentId}/`}>作品ページを見る</a>
              {t.w.affiliateUrl && (
                <a class="btn btn-cta" href={`/go/${t.w.contentId}/`} rel="sponsored nofollow" data-cta="work">FANZAで見る <small>PR</small></a>
              )}
            </div>
            {movieIds.has(t.w.contentId) && <SampleMovie movie={t.w.sampleMovie} title={t.w.title} />}
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="new">
      <div class="section-head"><h2>新着</h2></div>
      <WorkGrid works={latest} />
    </section>

    {sale.length > 0 && (
      <section class="section" id="sale">
        <div class="section-head"><h2>セール中</h2></div>
        <WorkGrid works={sale} />
      </section>
    )}

    {seriesTop.length > 0 && (
      <section class="section" id="series">
        <div class="section-head"><h2>シリーズ別</h2></div>
        <div class="chips">
          {seriesTop.map((s) => <a class="chip" href={`/series/${s.id}/`}>{s.name}<span class="n">{s.count}</span></a>)}
        </div>
      </section>
    )}

    {coStars.length > 0 && (
      <section class="section" id="costars">
        <div class="section-head"><h2>共演の多い出演者</h2></div>
        <div class="chips">
          {coStars.map((c) => <a class="chip" href={`/actress/${c.id}/`}>{c.name}<span class="n">{c.count}</span></a>)}
        </div>
      </section>
    )}

    <section class="section" id="all">
      <div class="section-head"><h2>全作品</h2></div>
      <p class="muted">全{works.length}件（配信開始日の新しい順）</p>
      <WorkGrid works={shown} />
      {works.length > MAX_ALL && (
        <p style="margin-top: 16px"><a class="btn" href={exploreHref}>探索ページで全件を見る（{works.length}件）</a></p>
      )}
    </section>

    <section class="section" id="summary">
      <div class="section-head"><h2>まとめ</h2></div>
      <p>{summary}</p>
    </section>
  </article>

  <AdSlot name="actress-bottom" />
</Base>
