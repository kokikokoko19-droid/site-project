---
// 出演者ページ本体（検索の入口）。最新作と新着、おすすめ10選（ベイズ平均。1 作品ずつ WorkBlock で縦に並べる）、セール中、シリーズ別、共演、全作品、まとめ。
// 作品数で段階を分ける（第三者レビュー A I5・C-3）:
//   10本以上: 題名「〇〇のおすすめ作品ランキング{年}」／それ未満: 「〇〇の出演作品一覧（n本）」
//   5本未満: 10選と最新作の棚を出さず「全作品」だけ／3本未満: noindex（sitemap からも外す。astro.config.mjs）
// 文言は自動文だけ。公式の紹介文・レビュー本文・顔写真は使わない。
import '../styles/actress.css';
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumb from './Breadcrumb.astro';
import Shelf from './Shelf.astro';
import WorkGrid from './WorkGrid.astro';
import WorkBlock from './WorkBlock.astro';
import ProfileTable from './ProfileTable.astro';
import Toc from './Toc.astro';
import OpNote from './OpNote.astro';
import { loadCatalog } from '../lib/catalog.ts';
import type { CatalogWork } from '../lib/catalog.ts';
import { actressStats, globalMeanAvg, workBayes } from '../lib/actress-stats.ts';
import { actressIntro, actressSummary } from '../lib/autotext-actress.ts';
import { fmtDate } from '../lib/format.ts';

interface Props {
  id: string;
  name: string;
  works: CatalogWork[];
  /** おすすめ N 選に添える運営者の一言（content_id → 文）。無ければ自動文 */
  notes?: ReadonlyMap<string, string>;
  /** 運営者の紹介文（スプレッドシートから取り込んだもの。docs/07 の 11 章）。あればヘッダーの直下に「編集部から」として出す */
  copy?: string;
}

const { id, name, works, copy = '' } = Astro.props;
const catalog = loadCatalog();
const profile = catalog.actressProfiles.get(id) ?? null;
const stats = actressStats(catalog).get(id)!;

const MAX_ALL = 60;
const RANKING_MIN = 10; // これ以上で「ランキング」の題名
const TOP_MIN = 5; // これ以上で10選と最新作の棚を出す
const INDEX_MIN = 3; // これ未満は noindex
const total = works.length;
const year = new Date().getFullYear();
const intro = actressIntro(profile, stats);
const summary = actressSummary(profile, stats);

const meanAvg = globalMeanAvg(catalog);
// おすすめ10選: ベイズ平均の降順。同点は新しい順（works は配信開始日の降順なので安定ソートで保たれる）
const top = total >= TOP_MIN
  ? works.map((w) => ({ w, score: workBayes(w, meanAvg) })).sort((a, b) => b.score - a.score).slice(0, 10)
  : [];
// 運営者の一言（作品ID → 文）。呼び出し側（pages/actress/[id].astro）が loadCopy().work を渡す。無い作品は自動文
const notes: ReadonlyMap<string, string> = Astro.props.notes ?? new Map();
const latest = total >= TOP_MIN ? works[0] : undefined;
const recent = total >= TOP_MIN ? works.slice(1, 4) : [];
const sale = works.filter((w) => w.derivedLabels.includes('セール中')).slice(0, 8);
const seriesTop = stats.series.slice(0, 5);
const coStars = stats.coStars.slice(0, 8);
const shown = works.slice(0, MAX_ALL);

const toc = [
  ...(latest ? [{ id: 'new', label: '最新作と新着' }] : []),
  { id: 'profile', label: 'プロフィール' },
  ...(top.length > 0 ? [{ id: 'top10', label: `おすすめ作品${top.length}選` }] : []),
  ...(sale.length > 0 ? [{ id: 'sale', label: 'セール中' }] : []),
  ...(seriesTop.length > 0 ? [{ id: 'series', label: 'シリーズ別' }] : []),
  ...(coStars.length > 0 ? [{ id: 'costars', label: '共演の多い出演者' }] : []),
  { id: 'all', label: '全作品' },
  { id: 'summary', label: 'まとめ' },
];

const ranking = total >= RANKING_MIN;
const pageTitle = ranking ? `${name}のおすすめ作品ランキング${year}` : `${name}の出演作品一覧（${total}本）`;
const heading = ranking ? `${name}のおすすめ作品ランキング` : `${name}の出演作品一覧`;
const base = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, base).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', name, url: abs(`/actress/${id}/`) },
    ...(top.length > 0
      ? [{
          '@type': 'ItemList',
          name: `${name}のおすすめ作品${top.length}選`,
          itemListElement: top.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/v/${t.w.contentId}/`) })),
        }]
      : []),
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const exploreHref = `/explore/?act=${encodeURIComponent(name)}`;
---

<Base title={pageTitle} description={intro.slice(0, 120)} ogType="article" noindex={total < INDEX_MIN} dataUpdatedAt={catalog.meta.lastIngestAt ?? undefined}>
  <script slot="head" type="application/ld+json" set:html={jsonLdText} />

  <Breadcrumb items={[{ href: '/', label: 'トップ' }, { href: '/actress/', label: '出演者一覧' }, { label: name }]} />

  <article class="actress-page">
    <header class="section" style="margin-top: 8px">
      <h1>{heading}{!ranking && <span class="h1-count">（{total}本）</span>}</h1>
      <p class="auto-lead">{intro}</p>
    </header>

    <OpNote heading="編集部から" text={copy} />

    {
      latest && (
        <section class="section" id="new">
          <div class="section-head"><h2>最新作</h2></div>
          <a class="latest-row" href={`/v/${latest.contentId}/`}>
            <div class="thumb">{latest.imageSmall && <img src={latest.imageSmall} alt="" width="147" height="200" decoding="async" />}</div>
            <div class="latest-body">
              <span class="latest-title">{latest.title}</span>
              {fmtDate(latest.releasedAt) && <span class="dim">{fmtDate(latest.releasedAt)} 配信</span>}
            </div>
          </a>
          {recent.length > 0 && (
            <>
              <div class="section-head" style="margin-top: 24px"><h2>新着</h2><a class="more" href="#all">全作品へ</a></div>
              <Shelf works={recent} sub="date" label="新着の作品" />
            </>
          )}
        </section>
      )
    }

    <Toc items={toc} />

    <section class="section" id="profile">
      <div class="section-head"><h2>プロフィール</h2></div>
      <ProfileTable profile={profile} />
    </section>

    {
      top.length > 0 && (
        <section class="section" id="top10">
          <div class="section-head"><h2>おすすめ作品{top.length}選</h2></div>
          <p class="muted">レビューの平均を、件数の少なさを補正して並べています（ベイズ平均）。</p>
          {top.map((t, i) => (
            <WorkBlock work={t.w} rank={i + 1} note={notes.get(t.w.contentId)} ctaPos="actress-top" eager={i === 0} hideActress />
          ))}
        </section>
      )
    }

    {sale.length > 0 && (
      <section class="section" id="sale">
        <div class="section-head"><h2>セール中</h2></div>
        <WorkGrid works={sale} omitLabels={['セール中']} eager={0} />
      </section>
    )}

    {seriesTop.length > 0 && (
      <section class="section" id="series">
        <div class="section-head"><h2>シリーズ別</h2></div>
        <div class="chips">
          {seriesTop.map((s) => <a class="chip" href={`/series/${s.id}/`}>{s.name}<span class="n">{s.count}</span></a>)}
        </div>
      </section>
    )}

    {coStars.length > 0 && (
      <section class="section" id="costars">
        <div class="section-head"><h2>共演の多い出演者</h2></div>
        <div class="chips">
          {coStars.map((c) => <a class="chip" href={`/actress/${c.id}/`}>{c.name}<span class="n">{c.count}</span></a>)}
        </div>
      </section>
    )}

    <section class="section" id="all">
      <div class="section-head"><h2>全作品</h2><span class="sub nowrap">全{total}本（配信開始日の新しい順）</span></div>
      <WorkGrid works={shown} eager={latest ? 0 : 4} />
      {total > MAX_ALL && (
        <p style="margin-top: 16px"><a class="btn" href={exploreHref}>探索ページで全件を見る（{total}件）</a></p>
      )}
    </section>

    <section class="section" id="summary">
      <div class="section-head"><h2>まとめ</h2></div>
      <p>{summary}</p>
    </section>
  </article>

  <AdSlot name="actress-bottom" />
</Base>
