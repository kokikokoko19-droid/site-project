---
// （2026-11 現在、どこからも使っていない。作品ページのサンプル画像を本文に大きく並べる形に変えたため、SampleGallery から外した。理由は SampleGallery.astro の冒頭。再び使うときのために残す）
// サンプル画像の拡大表示（作品ページ）。公式配信の大きい画像を、切り取らず画面に収まる大きさでそのまま表示する。
// 画像の上には文字や印を重ねない（枚数・前後・閉じるは画像の外の帯に置く）。
// 開く対象は、ページ内の [data-lightbox-src] を持つボタン（SampleGallery が出す）。並び順は文書の順。
// 前後ボタン・閉じるボタン・Esc・左右キー・スワイプで操作する。開いている間は背後を inert にし、閉じたらフォーカスを戻す。
// JS が無いときは開かない（ギャラリーの小さい画像だけが見える）。
const SCRIPT = `(function () {
  var lb = document.getElementById('lightbox');
  if (!lb || lb.__bound) return;
  lb.__bound = true;
  var img = lb.querySelector('.lb-img'), stage = lb.querySelector('.lb-stage'), err = lb.querySelector('.lb-error');
  var count = lb.querySelector('.lb-count'), prevBtn = lb.querySelector('[data-lb-prev]'), nextBtn = lb.querySelector('[data-lb-next]');
  var closeBtn = lb.querySelector('[data-lb-close]');
  var items = [], index = 0, opener = null, inerted = [], startX = null, startY = null;
  function collect() { items = Array.prototype.slice.call(document.querySelectorAll('[data-lightbox-src]')); }
  function show(i) {
    if (items.length === 0) return;
    index = (i + items.length) % items.length;
    var src = items[index].getAttribute('data-lightbox-src');
    stage.classList.add('is-loading');
    err.hidden = true;
    img.hidden = false;
    img.removeAttribute('src');
    img.alt = 'サンプル画像 ' + (index + 1) + '（全' + items.length + '枚）';
    img.src = src;
    count.textContent = (index + 1) + ' / ' + items.length;
    var one = items.length < 2;
    prevBtn.disabled = one; nextBtn.disabled = one;
  }
  img.addEventListener('load', function () { stage.classList.remove('is-loading'); });
  img.addEventListener('error', function () {
    if (!img.getAttribute('src')) return;
    stage.classList.remove('is-loading');
    img.hidden = true;
    err.hidden = false;
  });
  function open(i, from) {
    collect();
    opener = from || document.activeElement;
    if (lb.parentNode !== document.body) document.body.appendChild(lb);
    inerted = [];
    Array.prototype.forEach.call(document.body.children, function (el) {
      if (el !== lb && !el.inert && el.tagName !== 'SCRIPT') { el.inert = true; inerted.push(el); }
    });
    lb.hidden = false;
    document.documentElement.classList.add('lb-open');
    show(i);
    closeBtn.focus();
  }
  function close() {
    if (lb.hidden) return;
    lb.hidden = true;
    document.documentElement.classList.remove('lb-open');
    inerted.forEach(function (el) { el.inert = false; });
    inerted = [];
    img.removeAttribute('src');
    if (opener && opener.focus) opener.focus();
  }
  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest && e.target.closest('[data-lightbox-src]');
    if (!t) return;
    e.preventDefault();
    collect();
    open(items.indexOf(t), t);
  });
  prevBtn.addEventListener('click', function () { show(index - 1); });
  nextBtn.addEventListener('click', function () { show(index + 1); });
  closeBtn.addEventListener('click', close);
  lb.addEventListener('click', function (e) { if (e.target === stage || e.target === lb) close(); });
  document.addEventListener('keydown', function (e) {
    if (lb.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
  });
  stage.addEventListener('touchstart', function (e) { var t = e.changedTouches[0]; startX = t.clientX; startY = t.clientY; }, { passive: true });
  stage.addEventListener('touchend', function (e) {
    if (startX === null) return;
    var t = e.changedTouches[0], dx = t.clientX - startX, dy = t.clientY - startY;
    startX = null;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? index + 1 : index - 1);
  });
})();`;
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="サンプル画像の拡大表示" hidden>
  <div class="lb-bar">
    <span class="lb-count" aria-live="polite"></span>
    <button class="lb-btn" type="button" data-lb-close>閉じる <span aria-hidden="true">×</span></button>
  </div>
  <div class="lb-stage is-loading">
    <div class="lb-skel" aria-hidden="true"></div>
    <img class="lb-img" alt="" decoding="async" />
    <p class="lb-error" hidden>画像を読み込めませんでした。通信の状態を確かめて、もう一度開いてください。</p>
  </div>
  <div class="lb-bar">
    <button class="lb-btn" type="button" data-lb-prev><span aria-hidden="true">‹</span> 前へ</button>
    <button class="lb-btn" type="button" data-lb-next>次へ <span aria-hidden="true">›</span></button>
  </div>
</div>
<script is:inline set:html={SCRIPT} />

<style is:global>
  /* is:global にする理由: 全要素に属性が付くのを避ける。.lightbox と .lb- はこの部品でしか使わない */
  html.lb-open, html.lb-open body { overflow: hidden; }
  .lightbox { position: fixed; inset: 0; z-index: 60; background: rgba(8, 6, 5, .96); display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .lightbox[hidden] { display: none; }
  .lb-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp); padding: var(--sp) calc(var(--sp) * 2); color: var(--fg1); font-size: var(--fs-s); }
  .lb-count { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lb-btn { min-width: 44px; min-height: 44px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 3px; background: transparent; color: var(--fg0); font: inherit; font-size: 14px; cursor: pointer; white-space: nowrap; }
  .lb-btn:hover { border-color: var(--fg2); background: var(--bg2); }
  .lb-btn:disabled { opacity: .4; cursor: default; }
  .lb-stage { position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 0 var(--sp); touch-action: pan-y; }
  /* 切り取らず、画面に収まる大きさで全体を表示する（拡大縮小のみ） */
  .lb-img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .lb-img[hidden] { display: none; }
  .lb-skel { position: absolute; inset: 10% 8%; border-radius: 3px; background: var(--bg2); box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); display: none; }
  .lb-stage.is-loading .lb-skel { display: block; }
  .lb-stage.is-loading .lb-img { opacity: 0; }
  .lb-error { position: relative; color: var(--fg1); font-size: var(--fs-s); text-align: center; max-width: 28em; }
  @media (prefers-reduced-motion: no-preference) { .lb-stage.is-loading .lb-skel { animation: lb-pulse 1.2s ease-in-out infinite; } }
  @keyframes lb-pulse { 50% { opacity: .55; } }
</style>
