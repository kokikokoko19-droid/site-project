---
// 作品ページ /v/{content_id}/（設計方針 2.1）。作品1件につき1ページを静的に生成する。
// 並びは「題名 → 主画像 →（サンプル動画）→ 価格と FANZA ボタン（PR）→ サンプル画像 → 自動文 → 仕様表 → 似た作品 → 末尾の CTA」
// （第三者レビュー A C1・B-3・D-8、運営者レビュー WP7）。動画は主画像の直下（スマホ）。動画が無い作品ではその枠を出さない。
// PC は左列に横長のジャケットとサンプル動画、右列に題名・価格と CTA・自動文・仕様表を置き、サンプル画像は両列の下に通しで置く。
// サンプル画像は公式の大きい版を縦に並べ、3 枚目の後と末尾に CTA（gallery-mid / gallery-end）を置く（SampleGallery.astro）。
// スマホは、メインの CTA が画面外にある間だけ画面下に細い帯（価格と「FANZAで見る PR」）を出す（JS 無しでは出ない）。
// 紹介文は公式の文章を使わず、データ駆動の自動文（pageText）だけを出す。欠けた項目は行ごと省き、「不明」などは出さない。
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaButton from '../../components/CtaButton.astro';
import AxisLinks from '../../components/AxisLinks.astro';
import SampleMovie from '../../components/SampleMovie.astro';
import SampleGallery from '../../components/SampleGallery.astro';
import { loadCatalog } from '../../lib/catalog.ts';
import type { CatalogWork } from '../../lib/catalog.ts';
import { pageText, positionOf, summaryText } from '../../lib/autotext.ts';
import { cardLabels, saleEnd } from '../../lib/card.ts';
import { discountRate, fmtDate, minutes, monthDay, ymd, yen } from '../../lib/format.ts';

/** active の作品すべて（loadCatalog は gone を除く）。作品は props で渡す */
export function getStaticPaths() {
  return loadCatalog().works.map((work) => ({ params: { id: work.contentId }, props: { work } }));
}

interface Props {
  work: CatalogWork;
}
const { work } = Astro.props;
const catalog = loadCatalog();

const names = (refs: { name: string }[]): string[] => refs.map((r) => (r.name ?? '').trim()).filter((s) => s !== '');
const cast = names(work.actresses);
const castLine = cast.length > 5 ? `${cast.slice(0, 5).join('、')}ほか` : cast.join('、');
const maker = work.makers.find((m) => m.id && (m.name ?? '').trim() !== '');
const mainActress = work.actresses.find((a) => a.id && (a.name ?? '').trim() !== '');
const mainSeries = work.series.find((s) => s.id && (s.name ?? '').trim() !== '');

// 本文は位置づけの1〜2文。meta description は事実を並べた要約の先頭120字（超えるときは末尾に「…」）
const text = pageText(work, positionOf(catalog, work));
const summary = summaryText(work);
const chars = [...summary];
const description = chars.length === 0 ? undefined : chars.length > 120 ? `${chars.slice(0, 120).join('')}…` : summary;

// パンくずは「トップ › 出演者一覧 › 出演者名 › 作品」。出演者がいなければメーカー、それも無ければトップの直下
const crumbs = [
  { href: '/', label: 'トップ' },
  ...(mainActress
    ? [{ href: '/actress/', label: '出演者一覧' }, { href: `/actress/${encodeURIComponent(mainActress.id)}/`, label: mainActress.name.trim() }]
    : maker
      ? [{ href: '/maker/', label: 'メーカー一覧' }, { href: `/maker/${encodeURIComponent(maker.id)}/`, label: maker.name.trim() }]
      : []),
  { label: work.title },
];

// 画像は公式配信の直リンク。大（横長のジャケット。おおむね 800×538）→ 一覧用（147×200）→ 無地の枠
const cover = work.imageLarge || work.imageList || null;
const coverSize = work.imageLarge ? { w: 800, h: 538 } : { w: 147, h: 200 };
const labels = cardLabels(work.derivedLabels, [], 99);
const HOT = new Set(['高評価', 'セール中', '初見向け']);

// 仕様表。欠けた行は出さない（レビューが0件の行も出さない）。「〜追い向け」は事実の言葉で書く（第三者レビュー A I6）
const seriesCount = mainSeries ? (catalog.bySeries.get(mainSeries.id)?.length ?? 0) : 0;
const followActress = work.derivedLabels.includes('出演者追い向け')
  ? work.actresses
      .map((a) => ({ name: (a.name ?? '').trim(), n: catalog.byActress.get(a.id)?.length ?? 0 }))
      .filter((a) => a.name !== '')
      .sort((a, b) => b.n - a.n)[0]
  : undefined;
const seriesValue = names(work.series).join('、');
const reviewOk = work.reviewCount > 0 && typeof work.reviewAvg === 'number' && Number.isFinite(work.reviewAvg);
const castRefs = work.actresses.map((a) => ({ id: a.id, name: (a.name ?? '').trim() })).filter((a) => a.name !== '');
const rows = [
  { label: '出演', value: cast.join('、'), cast: true },
  { label: '出演本数', value: followActress ? `${followActress.name}は掲載${followActress.n}本（この出演者の出演多数）` : '' },
  { label: 'メーカー', value: names(work.makers).join('、') },
  { label: 'シリーズ', value: seriesValue && seriesCount >= 2 ? `${seriesValue}（掲載${seriesCount}作）` : seriesValue },
  { label: '収録', value: minutes(work.volumeMin) },
  { label: '配信開始', value: fmtDate(work.releasedAt) },
  { label: 'レビュー', value: reviewOk ? `${work.reviewAvg!.toFixed(2)}点・${work.reviewCount}件` : '' },
].filter((r) => r.value !== '');

// サンプル動画の枠を出すか（SampleMovie.astro と同じ条件: https の埋め込み URL が1つ以上ある）。枠の上の主画像は imageLarge、無ければ imageSmall
const hasMovie = Object.values(work.sampleMovie?.sizes ?? {}).some((u) => typeof u === 'string' && /^https:\/\//.test(u));
const poster = work.imageLarge || work.imageSmall || work.imageList || null;

const price = yen(work.priceMin);
const onSale = work.derivedLabels.includes('セール中') && work.listPrice !== null && work.priceMin !== null && work.listPrice > work.priceMin;
const off = onSale ? discountRate(work.priceMin, work.listPrice) : null;
const end = onSale ? saleEnd(work) : '';
// 配信開始日が今日（日本時間）より後なら予約受付中
const todayJst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
const releaseDay = ymd(work.releasedAt);
const upcoming = releaseDay !== null && /^\d{4}-\d{2}-\d{2}$/.test(releaseDay) && releaseDay > todayJst ? monthDay(releaseDay) : '';

// /go/{id}/ は outboundUrl がある作品にしか作られない（go/[id].astro と同じ条件）。無い作品にはボタンを出さない
const hasLink = typeof work.outboundUrl === 'string' && work.outboundUrl.length > 0;
// サンプル画像の末尾に CTA が出るか（SampleGallery の END_MIN と同じ条件: 有効な URL が3枚以上）
const galleryEnd = hasLink && work.sampleImages.filter((u) => typeof u === 'string' && u.trim() !== '').length >= 3;

const similar = catalog.similar(work, 8);
// 末尾の CTA（work-bottom）。PC ではサンプル画像の直後に来るので、似た作品の棚が無く、画像の末尾に CTA がある作品では出さない（同じ画面に2つ並ぶのを避ける。画像の末尾を優先）
const showBottom = hasLink && !(galleryEnd && similar.length === 0);
// 似た作品の棚の終端。出演者がいれば出演者ページ、いつも探索（ジャンルの上位2つ。無ければ出演者・メーカー）
const exploreQuery = new URLSearchParams();
for (const g of names(work.genres).slice(0, 2)) exploreQuery.append('g', g);
if ([...exploreQuery].length === 0 && mainActress) exploreQuery.set('act', mainActress.name.trim());
if ([...exploreQuery].length === 0 && maker) exploreQuery.set('mak', maker.name.trim());
const exploreHref = `/explore/${[...exploreQuery].length ? `?${exploreQuery}` : ''}`;

// 構造化データ。商品（Product）ではなく CreativeWork を最小項目で。価格は入れない
const released = fmtDate(work.releasedAt) ? ymd(work.releasedAt) : null;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: work.title,
  ...(released ? { datePublished: released } : {}),
  ...(cover ? { image: cover } : {}),
  url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c'); // </script> で途切れないようにする

// スマホの下部固定の帯。メインと末尾の CTA がどちらも画面外にある間だけ出す
const STICKY_SCRIPT = `(function () {
  var bar = document.getElementById('work-sticky');
  if (!bar || !('IntersectionObserver' in window)) return;
  var targets = document.querySelectorAll('[data-cta-watch]');
  var visible = new Set();
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) visible.add(e.target); else visible.delete(e.target); });
    var show = visible.size === 0;
    bar.classList.toggle('is-shown', show);
    document.body.classList.toggle('has-sticky-cta', show);
    bar.inert = !show;
  });
  bar.inert = true;
  targets.forEach(function (t) { io.observe(t); });
})();`;
---

<Base title={work.title} description={description} dataUpdatedAt={catalog.meta.lastIngestAt ?? undefined}>
  <div class="work-page">
    <Breadcrumb items={crumbs} />

    <article class="stack">
      <div class:list={['work-main', { 'has-movie': hasMovie }]}>
        <header class="work-head">
          <h1>{work.title}</h1>
          {castLine && <p class="cast">出演　{castLine}</p>}
          {
            labels.length > 0 && (
              <div class="labels">
                {labels.map((l) => <span class:list={['label', { hot: HOT.has(l) }]}>{l}</span>)}
              </div>
            )
          }
        </header>

        <div class="work-cover">
          {cover && <img src={cover} alt={`${work.title}のパッケージ画像`} width={coverSize.w} height={coverSize.h} decoding="async" fetchpriority="high" />}
        </div>

        {
          hasMovie && (
            <div class="work-movie">
              <SampleMovie movie={work.sampleMovie} title={work.title} heading="サンプル動画" poster={poster} posterAlt={`${work.title}の主画像`} />
            </div>
          )
        }

        {
          (price || hasLink) && (
            <div class="cta-box work-buy" data-cta-watch>
              {
                price && (
                  <div class="work-price">
                    <span class="price">
                      <span class:list={{ sale: onSale }}>{price}</span>
                      {onSale && <s>{yen(work.listPrice)}</s>}
                    </span>
                    {off ? <span class="off">-{off}%</span> : null}
                    {end ? <span class="until">セールは{end}まで</span> : null}
                    {upcoming ? <span class="reserve">予約受付中（{upcoming} 配信）</span> : null}
                  </div>
                )
              }
              {!price && upcoming && <p class="reserve">予約受付中（{upcoming} 配信）</p>}
              {hasLink && <CtaButton id={work.contentId} pos="top" />}
              <p class="note">価格と配信形式はデータ更新時点のものです。最新は販売ページで確認してください。</p>
            </div>
          )
        }

        {
          work.sampleImages.length > 0 && (
            <section class="work-gallery">
              <div class="section-head"><h2>サンプル画像</h2></div>
              {/* 画像の途中と末尾の CTA（作品ページの上の CTA と同じ部品・同じ文言）。出す条件は SampleGallery 側で決める。
                  CtaButton の pos の型は top/sticky/bottom だけだが、data-cta-pos にそのまま出るだけなので gallery-mid / gallery-end を渡す */}
              <SampleGallery images={work.sampleImages}>
                {hasLink && <div slot="mid" class="cta-box work-gallery-cta" data-cta-watch><CtaButton id={work.contentId} pos={'gallery-mid' as 'top'} /></div>}
                {hasLink && <div slot="end" class="cta-box work-gallery-cta" data-cta-watch><CtaButton id={work.contentId} pos={'gallery-end' as 'top'} /></div>}
              </SampleGallery>
            </section>
          )
        }

        {
          text && (
            <div class="work-text">
              <p>{text}</p>
              <p class="auto-note">作品データから自動で作成した紹介です</p>
            </div>
          )
        }

        <div class="work-spec">
          <dl class="spec">
            {
              rows.map((r) => (
                <>
                  <dt>{r.label}</dt>
                  <dd>
                    {r.cast ? (
                      // 出演者名は軸ページ（/actress/{id}/）へ。id が無い名前は文字だけ
                      <>
                        {castRefs.map((a, i) => (
                          <>
                            {i > 0 && '、'}
                            {a.id ? <a class="cast-link" href={`/actress/${encodeURIComponent(a.id)}/`}>{a.name}</a> : a.name}
                          </>
                        ))}
                      </>
                    ) : (
                      r.value
                    )}
                  </dd>
                </>
              ))
            }
          </dl>
          <AxisLinks actresses={work.actresses} series={work.series} makers={work.makers} genres={work.genres} />
        </div>
      </div>

      {
        similar.length > 0 && (
          <section>
            <div class="section-head">
              <h2>似た作品</h2>
              <span class="sub">タグの重なりと同出演者・同シリーズで自動選定</span>
            </div>
            <Shelf works={similar} label="似た作品">
              <Fragment slot="end">
                {mainActress && (
                  <a class="shelf-end" href={`/actress/${encodeURIComponent(mainActress.id)}/`}>
                    <span>この出演者の作品をすべて見る</span><span class="dim">{mainActress.name.trim()}</span>
                  </a>
                )}
                <a class="shelf-end" href={exploreHref}><span>似た条件で探索</span></a>
              </Fragment>
            </Shelf>
          </section>
        )
      }

      {
        showBottom && (
          <div class:list={['cta-box', 'work-bottom', { 'after-gallery-cta': galleryEnd }]} data-cta-watch>
            <div class="work-price">
              {price && (
                <span class="price">
                  <span class:list={{ sale: onSale }}>{price}</span>
                  {onSale && <s>{yen(work.listPrice)}</s>}
                </span>
              )}
              {off ? <span class="off">-{off}%</span> : null}
              {upcoming ? <span class="reserve">予約受付中（{upcoming} 配信）</span> : null}
            </div>
            <CtaButton id={work.contentId} pos="bottom" />
          </div>
        )
      }

      <AdSlot name="work-bottom" />
    </article>

    {
      hasLink && (
        <div class="work-sticky" id="work-sticky">
          {price && <span class:list={['price', { sale: onSale }]}>{price}</span>}
          <CtaButton id={work.contentId} pos="sticky" block={false} />
        </div>
      )
    }
  </div>
  {hasLink && <script is:inline set:html={STICKY_SCRIPT} />}
  <script is:inline type="application/ld+json" set:html={ldJson} />
</Base>

<style is:global>
  /* is:global にする理由: scoped だと全要素に属性が付き、数千ページ分のHTMLが膨らむ。クラス名は .work- で始めて衝突を避ける */
  .work-page .crumb, .work-head { overflow-wrap: anywhere; }
  .work-page .section-head h2 { flex: none; font-size: 18px; }
  .work-main { display: grid; gap: calc(var(--sp) * 2.5); grid-template-areas: "head" "cover" "movie" "buy" "gallery" "text" "spec"; }
  .work-main > * { min-width: 0; }
  .work-head { grid-area: head; margin: 0; }
  /* 題名は折り返す（長い英数字でも横にはみ出さない） */
  .work-head h1 { overflow-wrap: anywhere; text-wrap: balance; white-space: normal; max-width: 100%; }
  .work-head h1 { font-family: var(--font-title); }
  .work-cover { grid-area: cover; border-radius: 3px; overflow: hidden; background: var(--bg2); box-shadow: inset 0 0 0 1px rgba(255,255,255,.07); aspect-ratio: auto; min-height: 120px; }
  /* 横長のジャケットを比率どおりに表示する（切り取らない。width/height 属性で読み込み前の高さを確保） */
  .work-cover img { width: 100%; height: auto; }
  .work-buy { grid-area: buy; }
  .work-movie { grid-area: movie; }
  .work-gallery { grid-area: gallery; }
  .work-text { grid-area: text; display: grid; gap: 6px; }
  .work-text p { font: 400 15px/1.85 var(--font); color: var(--fg1); }
  .work-text .auto-note { font-size: 11.5px; line-height: 1.5; color: var(--fg2); }
  .work-spec { grid-area: spec; display: grid; gap: calc(var(--sp) * 2); }
  .work-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .work-price .off { color: var(--seal); font-weight: 700; font-size: 14px; white-space: nowrap; }
  .work-price .until, .work-price .reserve, .work-buy .reserve { color: var(--fg1); font-size: 12.5px; white-space: nowrap; }
  .work-price .reserve, .work-buy .reserve { color: var(--accent); }
  @media (min-width: 960px) {
    .work-main {
      grid-template-columns: minmax(420px, 520px) minmax(0, 1fr);
      /* 5 行目（1fr）が左列の余った高さを受け止め、右列の行間が開かないようにする */
      grid-template-rows: auto auto auto auto 1fr auto;
      grid-template-areas: "cover head" "cover buy" "cover text" "cover spec" "cover ." "gallery gallery";
      column-gap: calc(var(--sp) * 5);
      align-items: start;
    }
    /* 動画がある作品は、左列の主画像の下に動画を置く（右列の CTA の下に置くと、自動文と仕様表が下に押し下げられるため） */
    .work-main.has-movie {
      grid-template-rows: auto auto 1fr auto auto 1fr auto;
      grid-template-areas: "cover head" "cover buy" "cover ." "movie text" "movie spec" "movie ." "gallery gallery";
    }
    .work-movie { align-self: start; }
  }
  .work-bottom { max-width: 520px; }
  /* PC では似た作品の棚が 1 段（高さ 400px ほど）なので、画像の末尾の CTA と末尾の CTA が同じ画面に入る。画像の末尾を優先して末尾の CTA は出さない。
     スマホは自動文と仕様表が間に入って 1 画面より離れるので出す */
  @media (min-width: 960px) { .work-bottom.after-gallery-cta { display: none; } }
  /* 棚の終端カード */
  .shelf-end { display: flex; flex-direction: column; justify-content: center; gap: 6px; aspect-ratio: 3 / 4; padding: var(--sp); border: 1px dashed var(--line-strong); border-radius: 3px; color: var(--accent); font-size: 13px; line-height: 1.5; text-align: center; align-items: center; }
  .shelf-end:hover { border-color: var(--accent); background: var(--accent-soft); }
  .shelf-end .dim { font-size: 11.5px; overflow-wrap: anywhere; }
  /* スマホの下部固定の帯（高さ 56px）。メインの CTA が画面外にある間だけ出す。PC では出さない */
  .work-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; height: 56px; display: none; align-items: center; justify-content: space-between; gap: var(--sp); padding: 0 calc(var(--sp) * 2); background: var(--bg1); border-top: 1px solid var(--line-strong); box-shadow: 0 -6px 16px rgba(0,0,0,.45); }
  .work-sticky .price { font-size: 18px; white-space: nowrap; }
  .work-sticky .btn { min-height: 42px; flex: 0 1 auto; white-space: nowrap; }
  @media (max-width: 959px) {
    .work-sticky.is-shown { display: flex; }
    body.has-sticky-cta { padding-bottom: 56px; }
  }
</style>
