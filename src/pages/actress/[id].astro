---
// 出演者ページ（/actress/{id}/）。索引（catalog.byActress）のキーごとに1ページ作る。中身は ActressPage。
import ActressPage from '../../components/ActressPage.astro';
import { loadCatalog } from '../../lib/catalog.ts';

export function getStaticPaths() {
  const catalog = loadCatalog();
  return [...catalog.byActress].map(([id, works]) => ({
    params: { id },
    props: { name: catalog.refNames.actress.get(id) ?? id, works },
  }));
}

const { id } = Astro.params as { id: string };
const { name, works } = Astro.props;
---

<ActressPage id={id} name={name} works={works} />
