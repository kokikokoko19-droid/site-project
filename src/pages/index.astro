---
// トップ。構成は docs/02_設計方針.md の 2.1 と mocks/top.html に合わせる。
// 運営者から／今日の発見／軸から探す／特集とガイド／新着／セール中
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { loadCatalog } from '../lib/catalog.ts';

const catalog = loadCatalog();

// 今日の発見は meta.todays の3件。無ければ「高評価」ラベルの作品
const todays = catalog.todays(3);
const discoveries = todays.length > 0 ? todays : catalog.byLabel('高評価', 3);

// 軸の入口。軸の一覧ページは無いので、件数と、作品数の多い12件を名前チップで出す
const TOP_AXES = 12;
const axes = [
  { key: 'actress', label: '出演者', unit: '人', index: catalog.byActress, names: catalog.refNames.actress },
  { key: 'series', label: 'シリーズ', unit: '件', index: catalog.bySeries, names: catalog.refNames.series },
  { key: 'maker', label: 'メーカー', unit: '社', index: catalog.byMaker, names: catalog.refNames.maker },
  { key: 'genre', label: 'ジャンル', unit: '種', index: catalog.byGenre, names: catalog.refNames.genre },
].map((a) => ({
  key: a.key,
  label: a.label,
  unit: a.unit,
  total: a.index.size,
  top: [...a.index]
    .sort((x, y) => y[1].length - x[1].length) // 同数は索引に入った順（新しい作品側）のまま
    .slice(0, TOP_AXES)
    .map(([id, works]) => ({ id, name: a.names.get(id) ?? id, count: works.length })),
}));

// 特集とガイドは運営者が書く（src/content/）。最新の特集2件・ガイド3件を出す。
// 本番ビルド（import.meta.env.PROD）では draft を除き、開発時は下書きも出す（「下書き」バッジ付き）
const visible = ({ data }: { data: { draft: boolean } }) => !import.meta.env.PROD || !data.draft;
type Dated = { id: string; data: { date: Date } };
const newest = (a: Dated, b: Dated) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id);
const features = (await getCollection('feature', visible)).sort(newest).slice(0, 2);
const guides = (await getCollection('guide', visible)).sort(newest).slice(0, 3);

// 公開できる記事が0件の間は、仮文のカードを出す（特集とガイドを別々に判定する）。
// リンク先は一覧ページで、一覧には「準備中」と出る
const featurePlaceholders = [
  { title: '（特集タイトル 1）', text: '運営者が選んだ作品群と、その理由を書く場所です。' },
  { title: '（特集タイトル 2）', text: '季節やセールに合わせて入れ替えます。' },
];
const guidePlaceholders = [
  { title: 'このサイトの使い方', text: '探索ページの重みと絞り込みの考え方。' },
  { title: 'はじめての1本の選び方', text: '「初見向け」ラベルの意味と選び方。' },
  { title: '軸の解説', text: 'シリーズ追い、出演者追い、メーカーの作風。' },
];
---

<Base
  description="AV女優とおすすめ作品を見て回るカタログ。出演者・シリーズ・メーカー・ジャンルの軸から探せます。今日の発見、新着、セール中の作品も確認できます。"
  dataUpdatedAt={catalog.meta.lastIngestAt ?? undefined}
>
  <section class="section">
    {/* ページの見出し（h1）。ロゴはリンクなので、検索向けに説明文を h1 にする */}
    <h1 class="site-lead">AV女優とおすすめ作品を見て回るカタログ</h1>
    <div class="editorial">
      <div class="who">運営者から</div>
      <!-- TODO: 運営者が記入（今週見たもの、気づいたこと、サイトの使い方を数行で） -->
      <p>（ここは運営者が書く場所です。今週見たもの、気づいたこと、サイトの使い方を数行で。自動生成ではなく、人の声が最初に目に入るようにします。）</p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>今日の発見<span class="muted" style="margin-left: 8px">評価と定番から選んだ作品</span></h2>
      <a href="/explore/">もっと見る</a>
    </div>
    <WorkGrid works={discoveries} empty="作品データを準備中です。" />
  </section>

  <section class="section">
    <div class="section-head">
      <h2>軸から探す</h2>
      <a href="/explore/">探索ページへ</a>
    </div>
    <div class="entry">
      {axes.map((a) => (
        <a href="/explore/"><b>{a.label}</b><span>{a.total}{a.unit}</span></a>
      ))}
    </div>
    <div style="display: grid; gap: 24px; margin-top: 24px">
      {axes.filter((a) => a.top.length > 0).map((a) => (
        <div style="display: grid; gap: 8px">
          <h3>{a.label}<span class="muted" style="margin-left: 8px">作品数の多い順</span></h3>
          <div class="chips">
            {a.top.map((t) => (
              <a class="chip" href={`/${a.key}/${t.id}/`}>{t.name}<span class="n">{t.count}</span></a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head" style="flex-wrap: wrap">
      <h2>特集とガイド<span class="muted" style="margin-left: 8px">運営者が選び、運営者が書く</span></h2>
      <span class="row"><a href="/feature/">特集一覧</a><a href="/guide/">ガイド一覧</a></span>
    </div>
    <div class="hub">
      {features.length > 0
        ? features.map((e) => (
            <ArticleCard href={`/feature/${e.id}/`} title={e.data.title} description={e.data.description} date={e.data.date} kind="特集" draft={e.data.draft} />
          ))
        : featurePlaceholders.map((f) => (
            <a href="/feature/"><span class="kind">特集 ・ 準備中</span><span class="title">{f.title}</span><span class="muted">{f.text}</span></a>
          ))}
    </div>
    <div style="height: 16px"></div>
    <div class="hub three">
      {guides.length > 0
        ? guides.map((e) => (
            <ArticleCard href={`/guide/${e.id}/`} title={e.data.title} description={e.data.description} date={e.data.date} kind="ガイド" draft={e.data.draft} />
          ))
        : guidePlaceholders.map((g) => (
            <a href="/guide/"><span class="kind">ガイド ・ 準備中</span><span class="title">{g.title}</span><span class="muted">{g.text}</span></a>
          ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>新着<span class="muted" style="margin-left: 8px">直近の配信開始</span></h2>
      <a href="/new/">もっと見る</a>
    </div>
    <WorkGrid works={catalog.recent(5)} empty="作品データを準備中です。" />
  </section>

  <section class="section">
    <div class="section-head">
      <h2>セール中<span class="muted" style="margin-left: 8px">期間限定</span></h2>
      <a href="/sale/">もっと見る</a>
    </div>
    <WorkGrid works={catalog.onSale(5)} empty="現在セール中の作品はありません。" />
  </section>

  <AdSlot name="top-bottom" />
</Base>

<style>
  /* h1 だがロゴを主役にするため控えめに。本文の導入文と同じ大きさ */
  .site-lead { margin: 0 0 12px; font-size: 15px; font-weight: 500; color: var(--muted); letter-spacing: 0.02em; }
</style>
