---
// ガイド記事の一覧（/guide/）。記事は運営者が src/content/guide/ に書く。
// 本番ビルド（import.meta.env.PROD）では draft を除き、開発時は「下書き」バッジ付きで出す。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import '../../styles/article.css';

// 公開日の新しい順。同じ日は ID の順にして、並びが毎回同じになるようにする
const entries = (await getCollection('guide', ({ data }) => !import.meta.env.PROD || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
---

<Base
  title="ガイド"
  description="このサイトの使い方、はじめての1本の選び方、軸の解説など、運営者が書いたガイド記事の一覧です。"
>
  <nav class="crumb" aria-label="パンくず">
    <a href="/">トップ</a><span aria-hidden="true"> / </span><span aria-current="page">ガイド</span>
  </nav>

  <section class="section" style="margin-top: 16px">
    <div class="muted">ガイド</div>
    <h1>サイトの使い方と選び方</h1>
    <p class="muted">使い方、選び方、軸の解説。運営者が書いています。</p>
  </section>

  <section class="section">
    {
      entries.length > 0 ? (
        <div class="hub three">
          {entries.map((e) => (
            <ArticleCard
              href={`/guide/${e.id}/`}
              title={e.data.title}
              description={e.data.description}
              date={e.data.date}
              kind="ガイド"
              draft={e.data.draft}
            />
          ))}
        </div>
      ) : (
        <div class="empty">
          <p>準備中です。</p>
        </div>
      )
    }
  </section>
</Base>
